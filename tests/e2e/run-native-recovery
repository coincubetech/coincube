#!/usr/bin/env python3
"""Native full Recovery Kit suite; no GUI or broadcast acceptance."""
import argparse
import json
import os
from pathlib import Path
import sys
import hashlib
import shutil
import subprocess

root = Path(__file__).resolve().parent
if sys.version_info < (3, 11, 4):
    for name in ('python3.12', 'python3.13', 'python3.11'):
        candidate = shutil.which(name)
        if candidate and subprocess.run([candidate, '-c', 'import sys;sys.exit(sys.version_info<(3,11,4))'], capture_output=True).returncode == 0:
            os.execv(candidate, [candidate, str(Path(__file__).resolve()), *sys.argv[1:]])
    raise SystemExit('NATIVE_RECOVERY_PYTHON: supported Python interpreter unavailable')
os.umask(0o077)
venv = root / '.venv-native-recovery'
python = venv / 'bin/python'
lock = root / 'native-recovery.requirements.lock'
stamp = venv / 'requirements.sha256'
expected = hashlib.sha256(lock.read_bytes()).hexdigest()
if venv.is_symlink() or (venv.exists() and (venv.stat().st_uid != os.getuid() or venv.stat().st_mode & 0o077)):
    raise SystemExit('NATIVE_RECOVERY_VENV: expected owned private directory')
if Path(sys.prefix) != venv:
    if not python.exists():
        subprocess.run([sys.executable, '-m', 'venv', str(venv)], check=True, capture_output=True)
    local = root / '.local'; local.mkdir(mode=0o700, exist_ok=True)
    with (local / 'native-recovery-bootstrap.log').open('ab') as log:
        if not stamp.exists() or stamp.read_text() != expected:
            result = subprocess.run([str(python), '-m', 'pip', 'install', '--disable-pip-version-check', '-r', str(lock)], stdout=log, stderr=log)
            if result.returncode:
                raise SystemExit('NATIVE_RECOVERY_DEPENDENCIES: private bootstrap diagnostics retained')
            stamp.write_text(expected)
    os.execv(str(python), [str(python), str(Path(__file__).resolve()), *sys.argv[1:]])

os.umask(0o077)
sys.path.insert(0, str(Path(__file__).resolve().parent))
from harness.native_recovery import NativeRecovery
from harness.state import Blocked, private_read
from harness.clients import http, REST

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--config', required=True)
parser.add_argument('--run-dir', required=True)
args = parser.parse_args()
suite = None
try:
    config = json.loads(private_read(args.config))
    if set(config) != {'version', 'native_recovery', 'account_email', 'connect_cache'} or config['version'] != 1:
        raise Blocked('NATIVE_RECOVERY_CONFIG', 'Use a private version1 native Recovery Kit configuration.')
    # NativeRecovery verifies source BEFORE this credential cache is read.
    suite = NativeRecovery(config['native_recovery'], args.run_dir, {'standalone': str(Path(args.run_dir).absolute())})
    cache = json.loads(private_read(config['connect_cache']))
    accounts = [a for a in cache['accounts'] if a['email'] == cache.get('active_email') == config['account_email']]
    if len(accounts) != 1:
        raise Blocked('NATIVE_RECOVERY_ACCOUNT', 'Exactly one explicitly bound disposable QA account is required.')
    account = accounts[0]
    user = json.loads(http(REST + '/api/v1/user', headers={'Authorization': 'Bearer ' + account['tokens']['access_token']}))
    if user['email'].casefold() != config['account_email'].casefold():
        raise Blocked('NATIVE_RECOVERY_ACCOUNT', 'Authenticated QA identity changed.')
    suite.execute(account, user['id'])
except Blocked as error:
    print(error.code + ': ' + str(error), file=sys.stderr)
    raise SystemExit(2)
finally:
    if suite:
        suite.close()
